{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptroom",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/p/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "promptroom", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "vars": {"AUTH_BASE_URL": "http://localhost:8787"},
  "observability": {"enabled": false}
}
