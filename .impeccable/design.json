      "css": ".ds-button-secondary{font-family:\"Geist Variable\",system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 11px;border:1px solid transparent;border-radius:12px;background:var(--secondary,#eeebfb);color:var(--secondary-foreground,#403487);font-size:14px;font-weight:500;cursor:pointer;transition:box-shadow .15s;}.ds-button-secondary:hover{background:color-mix(in oklab,var(--secondary,#eeebfb) 90%,transparent)}.ds-button-secondary:active{box-shadow:none}.ds-button-secondary:disabled{opacity:.64;pointer-events:none}.ds-button-secondary:focus-visible{outline:3px solid var(--ring,#6856d5);outline-offset:2px}@media(max-width:760px){.ds-button-secondary{min-height:44px;height:auto;white-space:normal}}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition-duration:.01ms}}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Default desktop size; phone targets expand to at least 44px.",
      "html": "<button class=\"ds-button-ghost\" type=\"button\">Share</button>",
      "css": ".ds-button-ghost{font-family:\"Geist Variable\",system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 11px;border:1px solid transparent;border-radius:12px;background:transparent;color:var(--foreground,#262522);font-size:14px;font-weight:500;cursor:pointer;transition:box-shadow .15s;}.ds-button-ghost:hover{background:var(--accent,#eeebfb)}.ds-button-ghost:active{box-shadow:none}.ds-button-ghost:disabled{opacity:.64;pointer-events:none}.ds-button-ghost:focus-visible{outline:3px solid var(--ring,#6856d5);outline-offset:2px}@media(max-width:760px){.ds-button-ghost{min-height:44px;height:auto;white-space:normal}}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition-duration:.01ms}}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Outlined field with a visible keyboard focus treatment.",
      "html": "<label class=\"ds-field\">Prompt name<input class=\"ds-input\" placeholder=\"Name your prompt\"></label>",
      "css": ".ds-field{font-family:\"Geist Variable\",system-ui,sans-serif;display:grid;gap:8px;font-size:14px;color:var(--foreground,#262522)}.ds-input{font-family:\"Geist Variable\",system-ui,sans-serif;height:32px;padding:0 11px;border:1px solid var(--input,#858178);border-radius:12px;background:var(--background,#faf9f6);color:var(--foreground,#262522);font-size:14px}.ds-input::placeholder{color:var(--muted-foreground,#68655f)}.ds-input:hover{border-color:var(--foreground,#262522)}.ds-input:focus-visible{border-color:var(--ring,#6856d5);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#6856d5) 24%,transparent)}.ds-input:focus-visible{outline:3px solid var(--ring,#6856d5);outline-offset:2px}@media(max-width:760px){.ds-input{min-height:44px;font-size:16px}}"
    },
    {
      "name": "Selected Prompt",
      "kind": "nav",
      "refersTo": "prompt-selected",
      "description": "A selected library entry uses fill, border, and an inset marker.",
      "html": "<nav aria-label=\"Choose a prompt\"><button class=\"ds-prompt\" type=\"button\" aria-current=\"true\"><strong>Grammar corrector</strong><span>Correct your writing while keeping your meaning and voice.</span></button></nav>",
      "css": ".ds-prompt{font-family:\"Geist Variable\",system-ui,sans-serif;display:flex;flex-direction:column;align-items:flex-start;gap:.4rem;max-width:260px;text-align:left;padding:.85rem;border-radius:12px;border:1px solid var(--primary,#5144b8);background:var(--secondary,#eeebfb);color:var(--foreground,#262522);box-shadow:inset 3px 0 var(--primary,#5144b8);cursor:pointer}.ds-prompt strong{font-size:.875rem;font-weight:600}.ds-prompt span{font-size:.8rem;line-height:1.5;color:var(--muted-foreground,#68655f)}.ds-prompt:hover{background:var(--muted,#f0efeb)}.ds-prompt:focus-visible{outline:3px solid var(--ring,#6856d5);outline-offset:2px}@media(forced-colors:active){.ds-prompt{outline:2px solid Highlight}}"
    },
    {
      "name": "Prompt Preview",
      "kind": "card",
      "refersTo": "preview",
      "description": "Disclosure surface with a character count and selectable wrapped text.",
      "html": "<details class=\"ds-preview\"><summary>Preview complete prompt <span>Example</span></summary><pre>Correct the following text while keeping its meaning and voice.\n\nYour input appears here.</pre></details>",
      "css": ".ds-preview{font-family:\"Geist Variable\",system-ui,sans-serif;border:1px solid var(--border,#d7d4ce);border-radius:12px;background:var(--popover,#ffffff);color:var(--foreground,#262522)}.ds-preview summary{cursor:pointer;padding:1rem;font-size:.875rem;font-weight:500}.ds-preview summary span{float:right;font-size:.75rem;color:var(--muted-foreground,#68655f)}.ds-preview summary:hover{background:var(--muted,#f0efeb)}.ds-preview summary:focus-visible{outline:3px solid var(--ring,#6856d5);outline-offset:2px}.ds-preview pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;font-size:.875rem;line-height:1.75;padding:1.25rem;border-top:1px solid var(--border,#d7d4ce);margin:0;user-select:text}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Workbench",
    "overview": "Promptroom is calm, practical, and focused. Warm neutral surfaces and a limited violet accent frame the user's text. The interface gives saved prompts a stable place beside a spacious editing area; supporting controls stay compact.\n\nThe system is mostly flat, separated by borders and color. Subtle shadows give buttons and dialogs definition. Softly rounded, restrained controls make the workbench approachable without competing with its content. This records the existing `personal-ui/` system, not the original launcher at `/legacy/`.",
    "keyCharacteristics": [
      "Warm neutral canvas with violet actions and selection.",
      "One sans-serif family, with hierarchy carried by size and weight.",
      "Spacious workspace, compact supporting controls.",
      "Border-led grouping, gentle corners, and restrained depth.",
      "Equivalent light and dark themes with visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Change background and foreground roles together when switching themes. In light mode, accent matches secondary; in dark mode, accent has its own foreground. Dark focus uses the primary color.",
        "section": "colors"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use the existing registry depth for controls and overlays; use borders and surface color for the main workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use paired semantic colors and the existing light/dark theme mappings.",
      "Do keep prompt text readable, selectable, and fully wrapped in the preview.",
      "Do preserve visible focus, phone target sizing, and reduced-motion behavior.",
      "Do use the existing Base UI registry components with app-level accessibility overrides."
    ],
    "donts": [
      "Don't replace the selected prompt's border and marker with color alone.",
      "Don't let registry utilities remove the global focus outline.",
      "Don't obscure inputs with floating launch controls.",
      "Don't treat the legacy launcher's styling as the current workbench's design system."
    ]
  }
}
